{
  "name": "zero-gpt-plugin-contract",
  "version": "2.0.0",
  "purpose": "Document the intended ChatGPT app-plugin contract for Zero without local plugin packaging.",
  "architecture": {
    "chatgpt_layer": "App Plugin / MCP Server Connector",
    "core_layer": "Zero Core Server",
    "agent_layer": "Zero Agent"
  },
  "mcp": {
    "server_url": "https://zero.miru.work/mcp",
    "auth_mode_current": "none-private-test",
    "auth_mode_future": "oauth-at-core-boundary"
  },
  "forbidden_package_artifacts": [
    ".codex-plugin/plugin.json",
    "agent-plugin/plugin.json",
    "claude-plugin/plugin.json",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".app.json"
  ],
  "zero_layers": {
    "app_plugin": "metadata and connector identity only",
    "core_server": "MCP endpoint, tool listing, routing, policy, OAuth later",
    "agent": "paired machine executor"
  },
  "mcp_apps_ui": {
    "resource_uri": "ui://zero/chatgpt-auth/v1.html",
    "mime_type": "text/html;profile=mcp-app",
    "widget_domain_default": "https://zero.miru.work",
    "widget_domain_env": "ZERO_CHATGPT_WIDGET_DOMAIN",
    "tool_template_binding": {
      "tool": "zero.chatgpt.login",
      "meta_ui_resourceUri": "ui://zero/chatgpt-auth/v1.html",
      "openai_outputTemplate": "ui://zero/chatgpt-auth/v1.html"
    },
    "ui_only_tools": [
      "zero.chatgpt.auth.import"
    ],
    "secret_boundary": "raw secrets never return to ChatGPT text output; redacted status only",
    "available_display_modes": [
      "inline"
    ]
  }
}
